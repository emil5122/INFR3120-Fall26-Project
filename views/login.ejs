<%- include('partials/header') %>
<%- include('partials/nav') %>
<!-- START PAGE -->
    <body class ="login-page">
        <div>
            <h1 class="login-texttitle">Login</h1>
            <a>Welcome to the login page, if you have an account login below, otherwise create an account </a><a class="special-link" href="/register">here.</a>

             <form action="/auth/login" method="post" enctype="application/x-www-form-urlencoded" name="loginForm"> <!-- Sends to login endpoint. -->
                <p>
                    <label for="UserUsername">Username</label><br>
                    <input id="UserUsername" type="text" name="UserUsername" size="32" required> 
                </p>
                <p>
                    <label for="UserPassword">Password</label><br>
                    <input id="UserPassword" type="password" name="UserPassword" size="32" required>  
                </p>
                <p><input type="submit" value="Submit"></p>
            </form>
            <!-- Displays login errors -->
             <% if(error !== "none") {%> 
                  <a class="error"><%= error %></a>
                <% } else { %>
                  <a></a> <!-- No error to display. -->
             <% } %>
            
        </div>
<!-- END PAGE -->
<%- include('partials/footer') %>